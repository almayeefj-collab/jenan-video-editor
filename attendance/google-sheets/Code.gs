// تسجيل حضور غرفة الاجتماعات — ثانوية فاطمة الهاشمية
// الصقي هذا الملف كاملاً في Apps Script (الإضافات ← Apps Script) ثم انشريه كتطبيق ويب.

const SHEET_NAME = 'الحضور';

function doGet() {
  return HtmlService.createHtmlOutput(PAGE)
    .setTitle('تسجيل الحضور')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

function sheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(SHEET_NAME);
  if (!sh) {
    sh = ss.insertSheet(SHEET_NAME);
    sh.appendRow(['#', 'الاسم', 'المدرسة', 'وقت الحضور']);
    sh.setRightToLeft(true);
    sh.getRange(1, 1, 1, 4).setFontWeight('bold').setBackground('#ef7f1a').setFontColor('#ffffff');
    sh.setFrozenRows(1);
    sh.setColumnWidth(2, 240);
    sh.setColumnWidth(3, 240);
    sh.setColumnWidth(4, 170);
  }
  return sh;
}

function clean_(v) {
  let s = String(v || '').trim().slice(0, 80);
  if (/^[=+\-@]/.test(s)) s = "'" + s;   // يمنع تحويل النص إلى معادلة
  return s;
}

function register(name, school) {
  name = clean_(name);
  school = clean_(school);
  if (!name || !school) throw new Error('الاسم والمدرسة مطلوبة');
  const lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    const sh = sheet_();
    const n = sh.getLastRow();          // الصف الأول عناوين، فالرقم = عدد الصفوف الحالية
    sh.appendRow([n, name, school, new Date()]);
    sh.getRange(sh.getLastRow(), 4).setNumberFormat('yyyy/mm/dd  hh:mm');
    return n;
  } finally {
    lock.releaseLock();
  }
}

function getSchools() {
  const sh = sheet_();
  const last = sh.getLastRow();
  if (last < 2) return [];
  const vals = sh.getRange(2, 3, last - 1, 1).getValues().map(r => String(r[0])).filter(String);
  return Array.from(new Set(vals)).slice(0, 200);
}

const PAGE = "<!doctype html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تسجيل الحضور</title>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Mirza:wght@700&display=swap\">\n<style>\n  :root{\n    --bg:#f6f5f3; --surface:#ffffff; --fg:#2b2b2d; --muted:#76767b; --line:#e4e2df;\n    --accent:#ef7f1a; --accent-soft:#fdf0e3; --ok:#2f8f5b; --danger:#c0392b;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0}\n  body{background:var(--bg);color:var(--fg);font-family:'Cairo',system-ui,sans-serif;font-size:16px;line-height:1.6;padding:28px 16px 48px}\n  .wrap{max-width:560px;margin:0 auto;display:flex;flex-direction:column;gap:20px}\n  .head{background:var(--surface);border:1px solid var(--line);border-radius:14px;overflow:hidden}\n  .bar{height:6px;background:var(--accent)}\n  .inner{display:flex;flex-direction:column;align-items:center;gap:4px;padding:22px 20px 22px;text-align:center}\n  .logo{display:block;width:160px;max-width:60%;height:auto}\n  h1{font-family:'Mirza','Cairo',serif;font-weight:700;font-size:clamp(36px,9vw,48px);line-height:1.4;margin:8px 0 0;-webkit-text-stroke:.6px var(--fg)}\n  .sub{color:var(--muted);font-weight:700;margin:0;font-size:17px}\n  form{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:22px 20px;display:flex;flex-direction:column;gap:16px}\n  label{display:flex;flex-direction:column;gap:6px;font-weight:700}\n  input{font:inherit;font-size:18px;padding:12px 14px;border:1.5px solid var(--line);border-radius:10px;background:var(--bg);color:var(--fg);min-width:0;width:100%}\n  input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}\n  button{font:inherit;cursor:pointer;border:0;border-radius:10px;background:var(--accent);color:#fff;font-weight:800;font-size:19px;padding:13px}\n  button:disabled{opacity:.55;cursor:default}\n  button:focus-visible{outline:3px solid var(--fg);outline-offset:2px}\n  .msg{min-height:1.6em;margin:0;font-weight:700;text-align:center}\n  .msg.err{color:var(--danger)}\n  .done{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:30px 20px;text-align:center;display:flex;flex-direction:column;gap:8px;align-items:center}\n  .tick{width:64px;height:64px;border-radius:50%;background:var(--accent-soft);display:grid;place-items:center}\n  .done h2{margin:0;font-size:24px}\n  .done p{margin:0;color:var(--muted);font-weight:600}\n  .num{color:var(--accent);font-weight:800;font-variant-numeric:tabular-nums}\n  .again{background:transparent;color:var(--fg);border:1.5px solid var(--line);font-size:15px;padding:8px 16px;margin-top:8px}\n  [hidden]{display:none!important}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <header class=\"head\">\n    <div class=\"bar\"></div>\n    <div class=\"inner\">\n      <img class=\"logo\" src=\"data:image/jpeg;base64,\" alt=\"شعار ثانوية فاطمة الهاشمية\">\n      <h1>حيــاكــم اللّــه</h1>\n      <p class=\"sub\">سجّل حضورك في غرفة الاجتماعات</p>\n    </div>\n  </header>\n\n  <form id=\"f\" novalidate>\n    <label for=\"name\">الاسم\n      <input id=\"name\" autocomplete=\"name\" maxlength=\"80\" placeholder=\"اكتب اسمك\">\n    </label>\n    <label for=\"school\">المدرسة / الجهة\n      <input id=\"school\" list=\"schools\" maxlength=\"80\" placeholder=\"اكتب اسم المدرسة\">\n      <datalist id=\"schools\"></datalist>\n    </label>\n    <button id=\"go\" type=\"submit\">تسجيل الحضور</button>\n    <p class=\"msg\" id=\"msg\" role=\"status\"></p>\n  </form>\n\n  <section class=\"done\" id=\"done\" hidden>\n    <div class=\"tick\"><svg width=\"34\" height=\"34\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ef7f1a\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg></div>\n    <h2 id=\"thanks\">تم تسجيل حضورك</h2>\n    <p>رقم الحضور: <span class=\"num\" id=\"num\"></span></p>\n    <button class=\"again\" id=\"again\" type=\"button\">تسجيل شخص آخر</button>\n  </section>\n</div>\n<script>\n  const $ = id => document.getElementById(id);\n  const say = (t) => { $('msg').textContent = t; $('msg').className = 'msg err'; };\n  google.script.run.withSuccessHandler(list => {\n    (list || []).forEach(s => { const o = document.createElement('option'); o.value = s; $('schools').append(o); });\n  }).getSchools();\n  $('f').addEventListener('submit', e => {\n    e.preventDefault();\n    const name = $('name').value.trim(), school = $('school').value.trim();\n    if (!name || !school) { say('اكتب الاسم والمدرسة قبل التسجيل.'); (name ? $('school') : $('name')).focus(); return; }\n    $('go').disabled = true; $('go').textContent = 'جاري التسجيل…'; $('msg').textContent = '';\n    google.script.run\n      .withSuccessHandler(n => {\n        $('thanks').textContent = 'حياك الله يا ' + name.split(/\\s+/)[0];\n        $('num').textContent = n;\n        $('f').hidden = true; $('done').hidden = false;\n        $('go').disabled = false; $('go').textContent = 'تسجيل الحضور';\n      })\n      .withFailureHandler(() => {\n        say('ما تم التسجيل، تأكد من الإنترنت وحاول مرة ثانية.');\n        $('go').disabled = false; $('go').textContent = 'تسجيل الحضور';\n      })\n      .register(name, school);\n  });\n  $('again').addEventListener('click', () => {\n    $('name').value = ''; $('school').value = '';\n    $('done').hidden = true; $('f').hidden = false; $('name').focus();\n  });\n</script>\n</body>\n</html>\n";
